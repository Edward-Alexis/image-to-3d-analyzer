{
  "name": "image-to-3d-backend",
  "version": "1.0.0",
  "description": "Backend para analizador de imágenes a modelos 3D con auto-mejora",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "3d",
    "ai",
    "gemini",
    "image-analysis"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "@gradio/client": "^2.0.1",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/sharp": "0.32.0",
    "axios": "^1.6.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "winston": "3.18.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "20.19.25",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ]
  }
}
